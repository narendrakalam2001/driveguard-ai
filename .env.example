# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model ids are retired every few months - check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# --- HuggingFace (for hosting model weights) ---
HUGGINGFACE_TOKEN=your_huggingface_token_here

# --- Kaggle (for dataset downloads) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# --- Model settings ---
YOLO_BASE_WEIGHTS=yolov8m.pt
YOLO_PLATE_BASE_WEIGHTS=yolov8n.pt
DETECTION_CONF_THRESHOLD=0.4
DETECTION_IOU_THRESHOLD=0.45
# Tuned value: EasyOCR scores correct plates around 0.3-0.6, so 0.7 throws good reads away.
PLATE_CONFIDENCE_THRESHOLD=0.3

# --- Tracking ---
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=3

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Dashboard / security ---
DRIVEGUARD_API_URL=http://localhost:8000
# If set, state-changing API endpoints require header X-API-Key (set the same value for the dashboard).
DRIVEGUARD_API_KEY=
# ^ leave EMPTY for local use. Set it only when the API is public (then the dashboard reads the same value).
CORS_ALLOW_ORIGINS=*
# Local time used for charts and date filters (minutes from UTC; IST = 330)
DISPLAY_UTC_OFFSET_MINUTES=330

# --- Model download at deploy time (scripts/download_models.py) ---
HF_MODEL_REPO=your-hf-username/driveguard-ai-models

# --- Video processing quality / speed ---
# A vehicle is only flagged after this many speed readings (stops 5-frame tracker flickers becoming "violations").
MIN_SPEED_SAMPLES=12
# Readings at or above this km/h are treated as measurement errors, never shown or logged.
MAX_REPORTED_SPEED_KMPH=200
# Load the AI models when the API starts (so the first video does not wait ~30 s). false = load on first video.
PRELOAD_MODELS=true
# API address as seen by the BROWSER (for the live video stream). Needed when the API is deployed behind another URL.
DRIVEGUARD_PUBLIC_API_URL=
# Frame rate used when recording a live camera
STREAM_VIDEO_FPS=15

# --- Number plates ---
# Vehicles narrower than this (pixels, in the original video) are not tried: their plate is too small to read.
PLATE_MIN_VEHICLE_WIDTH_PX=90
# Keep up to 40 failed plate crops per video in evidence_frames/plate_debug/<session>/ so you can see why a read failed.
PLATE_DEBUG_CROPS=true
# Plate format to accept: IN (Indian, the product), UK or ANY (only to test the OCR on non-Indian footage).
PLATE_REGION=IN
# A car cannot gain more than this many km/h per second; bigger jumps in the measured speed are tracker glitches and ignored.
MAX_ACCEL_KMPH_PER_S=45
